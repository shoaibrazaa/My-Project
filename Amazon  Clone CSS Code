It Is A Amazon.com Clone CSS Code

* {
    margin: 0;
    font-family: Kievit;
    border: border-box;
}

.navbar {
    height: 60px;
    background-color: #0f1111;
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-evenly;
}

/** NAVBAR BOX 1 **/
.nav-logo {
    height: 50px;
    width: 115px;
}

.logo {
    background-image: url(../Images/amazon_logo.png);
    background-size: cover;
    height: 50px;
    width: 100%;
}

.add-icon {
    display: flex;
    align-items: center;
}

.border {
    border: 1px solid transparent;
}

.border:hover {
    border: 1px solid white;
}

/** NAVBAR BOX 2 **/
.add-first {
    color: #cccccc;
    font-size: 0.85rem;
    margin-left: 17px;
}

.add-second {
    font-size: 1rem;
    margin-left: 5px;
    font-weight: bold;
}

/** NAVBAR BOX 3 **/
.nav-search {
    display: flex;
    justify-content: space-evenly;
    background-color: antiquewhite;
    width: 600px;
    height: 40px;
    border-radius: 5px;
}

.search-select {
    width: 60px;
    background-color: #e6e6e6e1;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border: none;
    font-size: 0.80rem;
    text-align: center;
}

.search-input {
    width: 100%;
    font-size: 0.95rem;
    border: none;
    padding-left: 7px;
}

.vsar-lence-icon {
    width: 45px;
    height: 40px;
    background-color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

.vsar-image {
    width: 20px;
}

.search-icon {
    width: 60px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.4rem;
    background-color: #febd68f5;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    color: #0f1111;
}

.search-select:hover {
    background-color: #cecbcb;
}

.search-icon:hover {
    background-color: #faac45;
}

/** NAVBAR BOX 4 **/ 
span {
    font-size: 0.77rem;
}

.nav-signin-bottom {
    font-weight: bold;
    font-size: 0.90rem;
}

/** NAVBAR BOX 5 **/
.nav-cart i {
    font-size: 30px;
}

.nav-cart {
    font-size:0.90rem;
    font-weight: bold;
}

/** PANEL **/
.panel {
    height: 40px;
    background-color: #222f3d;
    color: white;
    display: flex;
    align-items: center;
}   

.panel-all i {
    margin-left: 20px;
    font-size: 1.25rem;
}

.panel-all span {
    padding-left: 2.5px;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.91rem;
}

.panel-ops a {
    text-decoration: none;
    color: white;
    padding-left: 20px;
    font-size: 0.85rem;
}

/** HERO SECTION **/
.hero-section {
    background-image: url(../Images/hero_image.jpg);
    background-size: cover;
    height: 400px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
}

.hero-msg {
    background-color: #f5f6f6;
    height: 40px;
    font-size: 0.85rem;
    width: 97%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 25px;
}

.hero-msg a {
    text-decoration: none;
    color: #007185
}

.hero-msg a:hover {
    text-decoration: underline;
    color: #ff8d22;
}

/** SHOP SECTION **/
main {
    background-color: #D4EAFA;
    padding-bottom: 50px;
}

.shop-section {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    background-color: #D4EAFA;
}

.box {
    /* border: 2px solid black; */
    height: 400px;
    width: 23%;
    background-color: white;
    padding: 20px 0px 15px;
    margin-top: 20px;
}

.boxone_img {
    height: 300px;
    background-size: cover;
    margin-top: 1rem;
    margin-bottom: 1rem;
}

.box_content {
    margin-left: 1rem;
    margin-right: 1rem;
}

.box_content a {
    color: #007185;
    text-decoration: none;
}

.box_content h2 {
    font-size: 1.20rem;
    font-weight: 700;
}

.box_content a:hover {
    color: #ff8d22;
}

