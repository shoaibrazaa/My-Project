/** FOOTER **/
/** NAVFOOTER 1 **/
.footpanel-one {
    background-color: #37475A;
    color: white;
    height: 50px;
    font-size: 0.98rem;
    display: flex;
    justify-content: center;
    align-items: center;
}

.footer-containor {
    background-color: #232F3E;
}

.footpanel-two {
    background-color: #232F3E;
    color: white;
    height: 350px;
    display: flex;
    justify-content: space-evenly;
}

ul {
    margin-top: 40px;
}

ul a {
    display: block;
    font-size: 0.85rem;
    margin-top: 15px;
    color: #dddddd;
}

ul p {
    font-weight: bold;
}

.footerline {
    border: 1px solid #3a4553;
    margin-top: 20px;
}

.footpanel-three {
    background-color: #232F3E;
    height: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
    
}

.footerlogo {
    background-image: url(../Images/amazon_logo.png);
    background-size: cover;
    height: 50px;
    width: 100px;
}

.footer-line {
    height: 35px;
    width: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 1px solid #848688;
    border-radius: 3px;
    margin-left: 7px;
    color: #dddddd;
    gap: 10px;
}


